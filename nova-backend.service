[Unit]
# systemd service for Nova's brain, in its own container on PVE2 - see backend.py
# and docs/decisions/0006.
#
# This is a template. Installed as root, with the user it runs as and where the
# project is filled in:
#
#   sed -e "s|__PROJECT_DIRECTORY__|/home/nova/Home-Assistant|g" -e "s|__USER__|nova|g" \
#       -e "s|__HOME__|/home/nova|g" \
#       nova-backend.service > /etc/systemd/system/nova-backend.service
#   systemctl daemon-reload
#   systemctl enable --now nova-backend
Description=Nova's brain
# Tailscale passes the tailnet's connections on to it.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
# It tells systemd once it has loaded, then keeps telling it it's still working, so a
# brain which has hung is restarted rather than left sitting there - see
# voice_assistant/watchdog.py.
Type=notify
WatchdogSec=60
User=__USER__
WorkingDirectory=__PROJECT_DIRECTORY__
ExecStart=__PROJECT_DIRECTORY__/venv/bin/python __PROJECT_DIRECTORY__/backend.py
# glibc gives each thread an arena of its own to allocate from, and keeps what the thread
# frees rather than handing it back. Each song's decode runs on fresh threads, which land
# on different arenas, so during a long music session the arenas grew by about 20 MB every
# ten minutes (48 MB to 253 MB in 100 minutes, with 29 arenas) while the main heap stayed
# flat. With only two arenas the threads share them, so what one frees the next reuses.
Environment=MALLOC_ARENA_MAX=2

# What it writes - its log, and the user's timers, alarms, memory and routines - is
# readable by its own user only, and it can never gain more privileges than it starts
# with. Everything but its own settings and data folders is read-only to it - those two
# it needs to write, as the settings page saves settings, keys and the satellites'
# passwords in the first, and the brain keeps timers, memory and logs in the second.
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__HOME__/.config/nova __HOME__/.local/share/nova

# Loading Piper and Nemotron takes a few seconds; a crash is restarted after a short pause.
TimeoutStartSec=120
Restart=on-failure
RestartSec=10
# The settings page's Restart stops the brain cleanly, then exits with this status
# (RESTART_EXIT_STATUS in voice_assistant/brain.py), as the nova user can't ask
# systemd itself.
RestartForceExitStatus=75

[Install]
WantedBy=multi-user.target
