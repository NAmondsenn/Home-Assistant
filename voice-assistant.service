[Unit]
# systemd user service for the voice assistant.
#
# This is a template. setup.sh fills in the placeholders and installs it to
# ~/.config/systemd/user/, or you can do it manually:
#
#   sed -e "s|__PROJECT_DIRECTORY__|$PWD|g" \
#       -e "s|__PYTHON__|$PWD/venv/bin/python|g" \
#       voice-assistant.service > ~/.config/systemd/user/voice-assistant.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now voice-assistant
#   sudo loginctl enable-linger "$USER"   # so it starts without logging in
#
# Running as a user service (rather than system-wide) keeps the assistant in the
# same session as the audio devices, so the microphone and speaker behave exactly
# as they do when main.py is run by hand.
Description=Voice Assistant

# There's no waiting for the network: a user service can't wait on the system's
# network-online.target, and the assistant manages without the network anyway,
# saying so when something needs it (see voice_assistant/network.py).

[Service]
# The assistant tells systemd once it's loaded, and then every so often that it's
# still working - only while its main loop keeps moving, so one which has hung is
# restarted rather than left looking healthy (see voice_assistant/watchdog.py).
# Loading the models takes a while on a cold boot, hence the long start allowance.
Type=notify
NotifyAccess=main
WatchdogSec=60
TimeoutStartSec=180
WorkingDirectory=__PROJECT_DIRECTORY__
ExecStart=__PYTHON__ __PROJECT_DIRECTORY__/main.py

# Anything the assistant writes - the Spotify token cache, saved timers, logs - is
# readable by this user only, rather than by everyone on the machine.
UMask=0077

# A little defence in depth, for something which will one day control the house:
# it can never gain more privileges than it starts with (no sudo, no setuid), and
# its /tmp is its own.
NoNewPrivileges=yes
PrivateTmp=yes

# Restarts the assistant if it crashes or hangs, with a short pause to avoid
# excessive crashing.
Restart=on-failure
RestartSec=10

# Allows the assistant time to close the audio stream cleanly when stopped.
KillSignal=SIGTERM
TimeoutStopSec=20

# Logs to the assistants journal.
# The assistant also keeps its own log in the project's logs/ folder.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
